# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Authentication ─────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys.
# Leave empty to run without authentication (local dev only).
API_KEYS=your-secret-key-here,another-key-if-needed

# ── Execution limits ───────────────────────────────────────────────────────────
# Hard timeout per execution in milliseconds (default: 10000)
EXEC_TIMEOUT_MS=10000
# Maximum output captured per execution in bytes (default: 1048576 = 1 MB)
MAX_OUTPUT_BYTES=1048576

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Max requests per IP per minute (default: 30)
RATE_LIMIT_MAX=30

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
